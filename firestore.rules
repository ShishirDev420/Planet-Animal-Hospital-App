rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUser(data) {
      return (
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('pawPoints' in data) || data.pawPoints is number) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('petName' in data) || (data.petName is string && data.petName.size() <= 128)) &&
        (!('petType' in data) || (data.petType is string && data.petType.size() <= 64)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
        (!('parentName' in data) || (data.parentName is string)) &&
        (!('weight' in data) || (data.weight is string)) &&
        (!('dietaryPreferences' in data) || (data.dietaryPreferences is string)) &&
        (!('surgicalHistory' in data) || (data.surgicalHistory is string)) &&
        (!('medicalHistory' in data) || (data.medicalHistory is string)) &&
        (!('age' in data) || (data.age is string)) &&
        (!('gender' in data) || (data.gender is string))
      );
    }
    
    function isValidPointsQueueItem(data) {
       return data.userId is string && data.userId.size() <= 128 &&
              data.status is string && data.status.size() <= 32 &&
              (!('points' in data) || data.points is number);
    }
    
    function isValidRequestItem(data) {
       return data.userId is string && data.userId.size() <= 128 &&
              data.status is string && data.status.size() <= 32;
    }

    match /users/{userId} {
      // Temporarily allow anyone to read and update users so the staff terminal can function.
      allow read: if true;
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == userId &&
                       (incoming().pawPoints == 0 || incoming().pawPoints == 500) &&
                       incoming().createdAt == request.time &&
                       incoming().keys().hasAll(['uid', 'email', 'pawPoints', 'createdAt']);
      allow update: if true;
    }

    match /pointsQueue/{documentId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid && isValidId(documentId);
      allow create: if isSignedIn() && isValidId(documentId) &&
                    isValidPointsQueueItem(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(documentId) &&
                    isValidPointsQueueItem(incoming()) &&
                    existing().userId == request.auth.uid &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == existing().status &&
                    incoming().points == existing().points;
      allow delete: if isSignedIn() && isValidId(documentId) && existing().userId == request.auth.uid;
    }

    match /requests/{documentId} {
      // Temporarily allow staff terminal to read, update, delete requests
      allow read: if true;
      allow create: if isSignedIn() && isValidId(documentId) &&
                    isValidRequestItem(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending';
      allow update: if true;
      allow delete: if true;
    }
  }
}