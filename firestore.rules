rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isStaff() { return isSignedIn() && request.auth.token.clinicId == 'planet-animal' && request.auth.token.clinicRole in ['coordinator', 'veterinarian', 'manager']; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUser(data) {
      return (
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('pawPoints' in data) || data.pawPoints is number) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('petName' in data) || (data.petName is string && data.petName.size() <= 128)) &&
        (!('petType' in data) || (data.petType is string && data.petType.size() <= 64)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
        (!('parentName' in data) || (data.parentName is string)) &&
        (!('weight' in data) || (data.weight is string)) &&
        (!('dietaryPreferences' in data) || (data.dietaryPreferences is string)) &&
        (!('surgicalHistory' in data) || (data.surgicalHistory is string)) &&
        (!('medicalHistory' in data) || (data.medicalHistory is string)) &&
        (!('age' in data) || (data.age is string)) &&
        (!('gender' in data) || (data.gender is string))
      );
    }
    
    function isValidPointsQueueItem(data) {
       return data.userId is string && data.userId.size() <= 128 &&
              data.status is string && data.status.size() <= 32 &&
              (!('points' in data) || data.points is number);
    }
    
    function isValidRequestItem(data) {
       return data.userId is string && data.userId.size() <= 128 &&
              data.status is string && data.status.size() <= 32;
    }

    match /users/{userId} {
      // Profiles are private; financial and care approval state is server-controlled.
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == userId &&
                       (incoming().pawPoints == 0 || incoming().pawPoints == 500) &&
                       (!('currentPlan' in incoming()) || incoming().currentPlan == 'free') &&
                       !incoming().keys().hasAny(['role','clinicRole','wallet','balance','entitlements','careApproved']) &&
                       incoming().createdAt == request.time &&
                       incoming().keys().hasAll(['uid', 'email', 'pawPoints', 'createdAt']);
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['uid','createdAt','pawPoints','currentPlan','role','clinicRole','wallet','balance','entitlements','careApproved']);
    }

    match /pointsQueue/{documentId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow write: if false;
    }

    match /requests/{documentId} {
      // Legacy appointment requests remain requests, never verified care.
      allow read: if (isSignedIn() && existing().userId == request.auth.uid) || isStaff();
      allow create: if isSignedIn() && isValidId(documentId) &&
                    isValidRequestItem(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending' && (!('points' in incoming()) || incoming().points == 0);
      allow update: if isStaff() || (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['status','date','time']) && incoming().status in ['pending','cancelled']);
      allow delete: if false;
    }
  }
}
