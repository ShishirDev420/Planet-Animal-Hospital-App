# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_SARVAM_API_KEY=your_sarvam_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Care pilot: server-only values. Never prefix these with VITE_.
CARE_FIREBASE_PROJECT_ID=
CARE_FIRESTORE_DATABASE_ID=
CARE_FIREBASE_SERVICE_ACCOUNT_JSON=
CARE_JOB_TOKEN=

# Private prescription pipeline (server only; requires dedicated private bucket).
CARE_PRIVATE_BUCKET=
CARE_SOURCE_RETENTION_DAYS=
CARE_OCR_API_KEY=
# Explicitly choose a supported, clinic-reviewed Gemini model; no automatic fallback.
CARE_OCR_MODEL=
